+describe('Session-scoped model selection', () => {
+  const CHAT: AgentModelSelection = { provider: 'deepseek-official', model: 'deepseek-chat' }
+  const CHAT_OFF: AgentModelSelection = { ...CHAT, reasoningEffort: ReasoningEffortId('off') }
+  const REASONER: AgentModelSelection = {
+    provider: 'deepseek-official', model: 'deepseek-reasoner', reasoningEffort: ReasoningEffortId('max'),
+  }
+  const REASONER_HIGH: AgentModelSelection = { ...REASONER, reasoningEffort: ReasoningEffortId('high') }
+
+  /** Remote whose default moves only through the Host's own default save. */
+  function savingRemote(ctx: Context, initial = CHAT) {
+    const defaults = { stored: initial, saved: [] as AgentModelSelection[] }
+    const remote = createSessionTestRemote(ctx, {
+      defaultModelSelection: () => defaults.stored,
+      saveDefaultModelSelection: (selection) => {
+        defaults.saved.push(selection)
+        defaults.stored = selection
+      },
+      cwd: '/tmp',
+    })
+    return { remote, defaults }
+  }
+
+  async function addSession(ctx: Context): Promise<{ agent: Agent; sessionId: SessionId }> {
+    const session = ctx.sessions.create()
+    const agent = {
+      id: session.id, session, status: 'idle', ctx, inbox: { nextTurn: [], nextStep: [] },
+    } as unknown as Agent
+    await ctx.agents.register(agent)
+    return { agent, sessionId: session.id }
+  }
+
+  it('installs a session selection without saving the default or touching other Sessions', async () => {
+    const { ctx, agent, sessionId } = await harness()
+    const other = await addSession(ctx)
+    const { remote, defaults } = savingRemote(ctx)
+
+    expect(expectValue(await remote.selectModel(request({ sessionId, ...REASONER, scope: 'session' as const }))))
+      .toEqual({ selected: REASONER, scope: 'session' })
+    await Promise.resolve()
+    expect(defaults.saved).toEqual([])
+    expect(ctx.agentDefaultModel.currentSelection()).toEqual(CHAT)
+    expect(currentSelection(ctx, sessionId)).toEqual(REASONER)
+    expect(currentSelection(ctx, other.sessionId)).toEqual(CHAT)
+    expect(agent.session.snapshotEvents().filter(event => event.type === 'model/selection').map(event => event.data))
+      .toEqual([REASONER])
+    expect(other.agent.session.snapshotEvents().some(event => event.type === 'model/selection')).toBe(false)
+
+    expect(expectValue(await remote.selectModel(request({ sessionId: other.sessionId, ...CHAT, scope: 'default' as const }))))
+      .toEqual({ selected: { ...CHAT, reasoningEffort: 'high' }, scope: 'default' })
+    await expect.poll(() => defaults.saved).toEqual([{ ...CHAT, reasoningEffort: 'high' }])
+    expect(currentSelection(ctx, sessionId)).toEqual(REASONER)
+    await ctx.fiber.dispose()
+  })
+
+  it('treats an omitted scope as the default scope', async () => {
+    const { ctx, sessionId } = await harness()
+    const { remote, defaults } = savingRemote(ctx)
+    expect(expectValue(await remote.selectModel(request({ sessionId, ...REASONER }))))
+      .toEqual({ selected: REASONER, scope: 'default' })
+    await expect.poll(() => defaults.saved).toEqual([REASONER])
+    await ctx.fiber.dispose()
+  })
+
+  it('routes the request and the switch notice through the session selection', async () => {
+    const { ctx, agent, sessionId } = await harness(CHAT)
+    const { remote, defaults } = savingRemote(ctx)
+    const signal = new AbortController().signal
+    const seed: LlmCallConfig = { provider: 'seed', model: 'seed' }
+
+    expectValue(await remote.selectModel(request({ sessionId, ...REASONER, scope: 'session' as const })))
+    expect((await ctx.systemPrompt.assemble()).variables)
+      .toMatchObject({ provider: REASONER.provider, model: REASONER.model })
+    await expect(agentEvents(ctx, agent).waterfall(
+      'agent/request', { turn: 1, step: 1, signal }, () => Promise.resolve(seed),
+    )).resolves.toEqual(REASONER)
+    const prompt = createUserMessage({ content: [{ type: 'text', text: 'next' }], source: { kind: 'user' } })
+    const decision = await agentEvents(ctx, agent).waterfall(
+      'agent/pre-step',
+      { agent, messages: [], turn: 1, step: 1, signal },
+      () => Promise.resolve({ kind: 'enter' as const, messages: [prompt] }),
+    )
+    expect(decision.kind === 'enter' ? decision.messages.map(message => message.content) : []).toEqual([
+      prompt.content,
+      [{
+        type: 'text',
+        text: '[model changed: assistant turns above this point were generated by deepseek-chat; the session continues with deepseek-reasoner]',
+      }],
+    ])
+
+    // The request header retires the pending pick; the Session then keeps its
+    // logged model even though the default moves.
+    agent.session.append('request/header', { header: { config: REASONER }, reason: 'initial' })
+    defaults.stored = CHAT_OFF
+    expect(currentSelection(ctx, sessionId)).toEqual(REASONER)
+    expect(new ApiSessionAgentController(ctx).selectionFor(agent).current).toEqual(REASONER)
+    expect(defaults.saved).toEqual([])
+    await ctx.fiber.dispose()
+  })
+
+  it('restores a session selection from the journal under a different default', async () => {
+    const source = await harness()
+    const { remote } = savingRemote(source.ctx)
+    expectValue(await remote.selectModel(request({ sessionId: source.sessionId, ...REASONER, scope: 'session' as const })))
+    const journal = structuredClone([...source.agent.session.snapshotEvents()])
+    await source.ctx.fiber.dispose()
+
+    const restored = { ctx: new Context() }
+    await restored.ctx.plugin(SessionStore)
+    await restored.ctx.plugin(SystemPrompt, { personaPrefix: '' })
+    await restored.ctx.plugin(LlmRuntime)
+    await restored.ctx.plugin(AgentRegistry)
+    savingRemote(restored.ctx, CHAT_OFF)
+    const session = restored.ctx.sessions.create(source.sessionId, { seed: journal, meta: { cwd: '/tmp' } })
+    const agent = {
+      id: session.id, session, status: 'idle', ctx: restored.ctx, inbox: { nextTurn: [], nextStep: [] },
+    } as unknown as Agent
+    await restored.ctx.agents.register(agent)
+
+    expect(currentSelection(restored.ctx, session.id)).toEqual(REASONER)
+    expect(new ApiSessionAgentController(restored.ctx).selectionFor(agent).current).toEqual(REASONER)
+    expect((await restored.ctx.systemPrompt.assemble()).variables)
+      .toMatchObject({ provider: REASONER.provider, model: REASONER.model })
+    await expect(agentEvents(restored.ctx, agent).waterfall(
+      'agent/request', { turn: 1, step: 1, signal: new AbortController().signal },
+      () => Promise.resolve({ provider: 'seed', model: 'seed' }),
+    )).resolves.toEqual(REASONER)
+    expect(restored.ctx.agentDefaultModel.currentSelection()).toEqual(CHAT_OFF)
+    await restored.ctx.fiber.dispose()
+  })
+
+  it('leaves a blank Session following the live default until it names a selection or a request', async () => {
+    const { ctx, sessionId } = await harness()
+    const other = await addSession(ctx)
+    const { remote, defaults } = savingRemote(ctx)
+
+    expectValue(await remote.selectModel(request({ sessionId, ...REASONER, scope: 'session' as const })))
+    defaults.stored = CHAT_OFF
+    expect(currentSelection(ctx, other.sessionId)).toEqual(CHAT_OFF)
+    expect(currentSelection(ctx, sessionId)).toEqual(REASONER)
+
+    // Selecting the current default is a snapshot, not a return to following it.
+    expectValue(await remote.selectModel(request({ sessionId, ...CHAT_OFF, scope: 'session' as const })))
+    defaults.stored = REASONER_HIGH
+    expect(currentSelection(ctx, sessionId)).toEqual(CHAT_OFF)
+    expect(currentSelection(ctx, other.sessionId)).toEqual(REASONER_HIGH)
+    expect(defaults.saved).toEqual([])
+    await ctx.fiber.dispose()
+  })
+})
